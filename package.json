{
  "name": "arcade-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Arcade for the browser: every Arcade app's actions on images, links, videos, selected text and pages.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/unit/**/*.test.ts\"",
    "e2e": "node --test --test-concurrency=1 \"test/e2e/**/*.test.ts\"",
    "check": "npm run typecheck && npm test && npm run build && python3 scripts/sync-design.py --check"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "typescript": "5.9.3"
  },
  "arcade": {
    "link": "v1.1.2"
  }
}
